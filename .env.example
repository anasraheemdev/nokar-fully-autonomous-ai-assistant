# ==============================================================================
# NOKAR – Fully Autonomous AI Desktop Assistant
# Environment Variable Configuration Template
# ==============================================================================

# Primary Google Gemini API Key (Required for Gemini Live and Model Ladder)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Assistant Identity & Profile
NOKAR_ASSISTANT_NAME=Nokar
NOKAR_USER_NAME=Commander
NOKAR_VOICE=Puck
NOKAR_UI_COLOR=#a855f7
NOKAR_DEFAULT_CITY=London

# Optional Intelligence Services
NEWS_API_KEY=
WEATHER_API_KEY=

# Executive Watchdog & Email Suite (Hostinger / IMAP / SMTP)
EMAIL_ADDRESS=user@example.com
EMAIL_PASSWORD=YOUR_EMAIL_APP_PASSWORD
EMAIL_IMAP_HOST=imap.hostinger.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.hostinger.com
EMAIL_SMTP_PORT=465

# Local Wake Word Detection (Hey Jarvis / Hey Nokar)
# Optional: one-click installation inside Settings -> Wake Word
ENABLE_LOCAL_WAKE_WORD=false
