# ── NOKAR (OBRIX LABS) — Production Release Git Ignore ──────────────────────────
# https://github.com/anasraheemdev/nokar-fully-autonomous-ai-assistant

# ── Secrets & Local Credentials (NEVER COMMIT) ───────────────────────────────────
config/api_keys.json
config/certs/
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*
!.env.example

# ── Local Runtime Memory & Personal Indexes ──────────────────────────────────────
memory/long_term.json
memory/profile.json
memory/ongoing_projects.json
memory/rag_vault.json
memory/*.db
!memory/*.example.json

# ── Python Build Artifacts & Bytecode ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Virtual Environments ─────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── IDEs, Editors & OS Files ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Scratch & Local Test Artifacts ────────────────────────────────────────────────
scratch/
.agents/
*.log
logs/
downloads/
screenshots/
temp/
tmp/
